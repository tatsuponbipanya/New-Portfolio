<%# グラフを描くためのライブラリを読み込む %>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script type="text/javascript" src="https://unpkg.com/chartkick@5.0.0/dist/chartkick.js"></script>

<div class="w-full max-w-none px-6 py-8">
  <h1 class="text-2xl font-bold mb-2 text-slate-800 text-center">
    📈 <%= @user.name %> さんの種目別・推定MAX（1RM）の推移
  </h1>
  <p class="text-center text-sm text-slate-500 mb-6">過去の最高記録の推移グラフです。</p>

  <%= link_to "#{@user.name}さんのプロフィール詳細へ戻る", user_path(@user), class: "inline-block mb-6 text-blue-600 hover:underline font-bold" %>

  <% if @menu_types.any? %>
    <% @menu_types.each do |menu| %>
      <div id="<%= menu %>" class="mb-10 bg-white p-6 rounded-lg shadow border border-slate-200 w-full">
        
        <h3 class="font-bold text-xl text-slate-800 mb-4 border-b pb-2 flex items-center justify-between">
          <span><%= menu %></span>
          <span class="text-sm sm:text-base font-extrabold text-emerald-600 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full shadow-sm">
            🏆 最高記録：<%= @max_1rm_by_menu[menu] || 0.0 %> kg
          </span>
        </h3>
        
        <div style="height: 350px; width: 100%;">
          <%= line_chart @chart_data_by_menu[menu], xtitle: "日付", ytitle: "推定MAX重量 (kg)", colors: ["#3b82f6"], library: { width: "100%", hAxis: { format: 'yyyy/MM/dd' } } %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-slate-500 italic text-center">まだグラフを表示するための筋トレ記録がありません。たくさん記録していこう！</p>
  <% end %>
</div>