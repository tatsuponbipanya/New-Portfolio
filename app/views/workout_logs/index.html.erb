<h1 class="text-3xl font-bold text-slate-800 mb-6">筋トレ開始！</h1>

<% if @workout_form && @workout_form.errors.any? %>
  <div class="error-messages bg-red-50 border border-red-200 text-red-800 p-4 my-4 rounded-md max-w-md">
    <p class="font-bold mb-2">⚠️ 入力内容を確認してください：</p>
    <ul class="list-disc pl-5 space-y-1 font-bold">
      <% @workout_form.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% # データ入力用フォーム（モデルを @workout_form、URLを明示する） %>
<%= form_with model: @workout_form, url: workout_logs_path, local: true, class: "space-y-4 max-w-md pb-16" do |f| %>
  
  <div class="flex flex-col">
    <%= f.label :workout_date, "トレーニング日時：", class: "font-bold text-slate-700 mb-1" %>
    <%= f.datetime_field :workout_date, value: Time.current.change(sec: 0), step: 60, class: "border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

<div class="flex flex-col">
    <label for="template_select" class="font-bold text-blue-700 mb-1 flex items-center">
      テンプレートから自動入力する
    </label>
    
    <% # select_tag の中身を、データ属性が仕込めるカスタム仕様に書き換え %>
    <select name="template_select" id="template_select" class="w-full border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
      <option value="">―― テンプレートを選択 ――</option>
      <% @templates.each do |template| %>
        <% 
          sets_json = template.workout_template_sets.map { |s| 
            { menu: s.menu_type, weight: s.default_weight.to_f, reps: s.default_reps } 
          }.to_json
        %>
        <option value="<%= template.id %>" data-sets="<%= sets_json %>">
          <%= template.name %>
        </option>
      <% end %>
    </select>

    <div class="flex items-center space-x-2 mt-2.5">
      <%= link_to "新規作成", new_workout_template_path, class: "flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-3 rounded text-sm transition text-center whitespace-nowrap shadow-sm" %>
      <%= link_to "編集・削除", manage_workout_templates_path, class: "flex-1 bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-2 px-3 rounded text-sm transition text-center whitespace-nowrap" %>
    </div>
</div>

  <div class="flex flex-col">
    <%= f.label :menu_type, "種目名：", class: "font-bold text-slate-700 mb-1" %>
    <%= f.select :menu_type, [["ベンチプレス", "ベンチプレス"], ["チンニング", "チンニング"],  ["スクワット", "スクワット"], ["ディップス", "ディップス"], ["ハンマーカール", "ハンマーカール"], ["サイドレイズ", "サイドレイズ"], ["デッドリフト", "デッドリフト"]],
       { prompt: "種目を選択" }, { id: "workout_form_menu_type", class: "border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" } %>
  </div>

  <hr class="border-slate-200 my-4">

  <% # インターバルの時間設定フォーム %>
  <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 my-4 text-center">
    <div class="text-sm font-bold text-slate-700 mb-2">⏱️ インターバル（休憩）時間の設定</div>
    <div class="flex items-center justify-center space-x-1">
      <% # デフォルトの時間設定 %>
      <input type="number" id="timer-min" value="5" min="0" max="59" class="w-14 bg-white text-slate-800 border border-slate-300 rounded p-2 text-center font-bold text-base focus:outline-none focus:ring-2 focus:ring-blue-500">
      <span class="text-sm font-bold text-slate-600">分</span>
      <input type="number" id="timer-sec" value="0" min="0" max="59" class="w-14 bg-white text-slate-800 border border-slate-300 rounded p-2 text-center font-bold text-base focus:outline-none focus:ring-2 focus:ring-blue-500">
      <span class="text-sm font-bold text-slate-600">秒</span>
    </div>
  </div>

  <h3 class="font-bold text-slate-700 mb-2">セットごとの記録</h3>
  
<div id="sets-container" class="space-y-3">
  
  <% # コントローラから戻ってきたデータの数だけループしてセット入力欄を作る %>
  <% @workout_form.sets_attributes_for_render.each_with_index do |set_data, index| %>
    
    <div class="set-row flex flex-col bg-slate-50 p-3 rounded border border-slate-200 space-y-2" data-set-index="<%= index %>">
      <div class="flex items-center space-x-3">
        <span class="set-label font-bold text-slate-500 w-16"><%= index + 1 %>セット</span>
        <div class="flex-1 flex items-center space-x-2">
          
          <input type="number" 
                 name="workout_form[sets_attributes][<%= index %>][weight]" 
                 value="<%= set_data['weight'] %>"
                 step="0.1" 
                 placeholder="重量(kg)"
                 list="weight-candidates"
                 class="border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 w-full bg-white text-center">
          <span class="text-slate-400 text-sm">kg</span>
          
          <input type="number" 
                 name="workout_form[sets_attributes][<%= index %>][reps]" 
                 value="<%= set_data['reps'] %>"
                 placeholder="回数"
                 list="reps-candidates"
                 class="border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 w-full bg-white text-center">
          <span class="text-slate-400 text-sm">回</span>
          
        </div>
      </div>
      <div class="text-right space-x-2">
        <% # 1セット目（indexが0）の時だけ削除ボタンを隠す %>
        <% if index > 0 %>
          <button type="button" class="delete-set-btn bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold py-1 px-3 rounded transition-colors duration-200">
            削除
          </button>
        <% end %>
        <button type="button" class="set-done-btn bg-slate-600 hover:bg-blue-600 text-white text-xs font-bold py-1 px-3 rounded transition-colors duration-200">
          完了（インターバル開始）
        </button>
      </div>
    </div>
    
  <% end %>

  <% # コントローラから入力候補の @recent_weights や @recent_reps を渡してもらう %>
  <datalist id="weight-candidates">
    <% if @recent_weights.present? %>
      <% @recent_weights.each do |w| %>
        <option value="<%= w %>"></option>
      <% end %>
    <% else %>
      <% # コントローラからデータがまだ来ていないとき用 %>
      <option value="40.0"></option>
      <option value="50.0"></option>
      <option value="60.0"></option>
    <% end %>
  </datalist>

  <datalist id="reps-candidates">
    <% if @recent_reps.present? %>
      <% @recent_reps.each do |r| %>
        <option value="<%= r %>"></option>
      <% end %>
    <% else %>
      <option value="1"></option>
      <option value="5"></option>
      <option value="10"></option>
    <% end %>
  </datalist>

</div>

  <button type="button" id="add-set-btn" class="w-full mt-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-2 px-4 rounded border border-dashed border-slate-300 transition text-sm">
    ＋ セットを追加する
  </button>

  <% # ⏱カウントダウンタイマーBOX（最初 hidden で隠れていて、ボタンを押すと出現する） %>
  <div id="interval-timer-box" class="hidden bg-slate-900 text-white p-4 rounded-lg shadow-xl mb-6 text-center border-2 border-blue-500 max-w-md">
    <div class="text-xs uppercase tracking-wider text-blue-400 font-bold mb-2">⏱️ Interval Timer</div>
    <% # 初期表示の文字　5分（05:00） %>
    <div id="timer-display" class="text-4xl font-mono font-bold my-1 animate-pulse">05:00</div>
    <p id="timer-sub-message" class="text-xs text-slate-400">次のセットまでしっかり休もう！</p>
    <button type="button" id="stop-timer-btn" class="hidden mt-2 text-xs bg-rose-600 hover:bg-rose-700 text-white px-3 py-1 rounded transition">タイマーを止める</button>
  </div>

  <div>
    <%= f.submit "筋トレ終了！", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-4 rounded shadow-md cursor-pointer transition duration-200" %>
  </div>
<% end %>

<% # javascriptフォルダのスクリプトを読み込む。一番下に書いておいた方がhtmlのあとに読み込まれるので、より安全 %>
<%= javascript_include_tag 'timer', 'data-turbo-track': 'reload' %>
<%= javascript_include_tag 'workout_template', 'data-turbo-track': 'reload' %>