<div class="fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat" 
     style="background-image: url('https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=1200&auto=format&fit=crop');">
</div>
<div class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs -z-10"></div>

<div class="relative min-h-screen px-4 py-12 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto">
    
    <%# ヘッダーエリア %>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-8 border-b border-white/20 mb-12">
      <div>
        <h1 class="text-4xl font-black tracking-tight text-white mb-2 drop-shadow-md">
          <%= @user.name %>さんのMY SHOES
        </h1>
        <p class="text-xs font-bold text-slate-200 tracking-wider uppercase drop-shadow-sm">
          Manage your running gears
        </p>
      </div>
      <div class="mt-4 sm:mt-0 flex flex-col sm:flex-row gap-3 items-center w-full sm:w-auto">
        <%= link_to "新しいシューズを登録する", new_shoe_path, class: "w-full sm:w-52 bg-blue-600 hover:bg-blue-500 text-white font-black py-4 rounded-xl shadow-lg shadow-blue-600/20 active:translate-y-0.5 transition-all duration-200 text-center text-sm" %>
        <%= link_to "ランニングを記録する", new_user_jog_path(current_user), class: "w-full sm:w-52 bg-emerald-500 hover:bg-emerald-400 text-white font-black py-4 rounded-xl shadow-lg shadow-emerald-500/20 active:translate-y-0.5 transition-all duration-200 text-center text-sm" %>
      </div>
    </div>

    <%# シューズ一覧のグリッド %>
    <% if @shoes.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @shoes.each do |shoe| %>
          <div class="bg-white/95 backdrop-blur-md border border-white/20 rounded-2xl shadow-2xl p-6 flex flex-col justify-between transition-all duration-200 hover:-translate-y-1 hover:shadow-blue-500/10">
            
            <div>
              <div class="flex items-start justify-between mb-4">
                <h2 class="text-xl font-black text-slate-800 tracking-tight leading-snug">
                  <%= shoe.name %>
                </h2>
                <span class="bg-blue-50 text-blue-600 text-xs font-extrabold px-2.5 py-1 rounded-md border border-blue-100 uppercase">
                  <%= shoe.width %>
                </span>
              </div>

              <div class="text-xs text-slate-500 space-y-1 mb-6">
                <p>サイズ：<span class="font-bold text-slate-700"><%= shoe.size %> cm</span></p>
                <% if shoe.bought_on.present? %>
                  <p>購入日：<span class="font-bold text-slate-700"><%= shoe.bought_on.strftime('%Y/%m/%d') %></span></p>
                <% else %>
                  <p>購入日：<span class="font-bold text-slate-400 italic">未登録</span></p>
                <% end %>
                <p>耐用基準：<span class="font-bold text-slate-700">500.0 km / 3年 (経年劣化)</span></p>
              </div>

              <%# === 📊 各種メーターの計算エリア === %>
              <% 
                # ① 走行距離の計算
                current_dist = shoe.total_distance.to_f
                dist_percentage = [((current_dist / 500.0) * 100).round, 100].min
                
                # ② 経過年数の計算（3年＝1095日として計算）
                if shoe.bought_on.present?
                  passed_days = (Date.today - shoe.bought_on.to_date).to_i
                  time_percentage = [((passed_days / 1095.0) * 100).round, 100].min
                  # 経過年数を少数第1位まで計算（例: 1.5年）
                  passed_years = (passed_days / 365.0).round(1)
                else
                  time_percentage = 0
                  passed_years = 0.0
                end

                # ③ 総合的な警告判定（距離が700km以上、または3年以上経過）
                is_expired = current_dist >= 700.0 || (shoe.bought_on.present? && shoe.bought_on < Date.today - 3.years)
                # 警告間近（距離が500km以上、または30ヶ月以上経過）
                is_warning = current_dist >= 500.0 || (shoe.bought_on.present? && shoe.bought_on < Date.today - 30.months)

                if is_expired
                  status_text = "もう替えた方がいいよ！"
                  text_color = "text-red-600"
                elsif is_warning
                  status_text = "そろそろ替え時です！"
                  text_color = "text-amber-600"
                else
                  status_text = "シューズの状態：良好！"
                  text_color = "text-green-600"
                end
              %>
              
              <div class="space-y-4 mb-6">
                <%# 🏃‍♂️ メーター1：走行距離 %>
                <div>
                  <div class="flex justify-between items-end text-xs mb-1">
                    <span class="text-slate-500 font-medium">🏃‍♂️ 走行距離</span>
                    <span class="font-black text-slate-800">
                      <%= shoe.total_distance %> <span class="text-slate-400 font-normal">/ 500.0 km</span>
                    </span>
                  </div>
                  <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                    <div class="<%= current_dist >= 500.0 ? 'bg-amber-500' : 'bg-blue-500' %> h-2.5 rounded-full transition-all duration-500" style="width: <%= dist_percentage %>%"></div>
                  </div>
                </div>

                <%# 📅 メーター2：経過年数（3年でMAX） %>
                <div>
                  <div class="flex justify-between items-end text-xs mb-1">
                    <span class="text-slate-500 font-medium">📅 経過年数</span>
                    <span class="font-black text-slate-800">
                      <%= passed_years %> <span class="text-slate-400 font-normal">/ 3.0 年</span>
                    </span>
                  </div>
                  <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                    <div class="<%= passed_years >= 3.0 ? 'bg-red-500' : (passed_years >= 2.5 ? 'bg-amber-500' : 'bg-emerald-500') %> h-2.5 rounded-full transition-all duration-500" style="width: <%= time_percentage %>%"></div>
                  </div>
                </div>

                <%# 📢 総合ステータス表示 %>
                <div class="text-right pt-1">
                  <span class="text-xs font-black tracking-tight <%= text_color %> bg-slate-50 border px-2.5 py-1 rounded-md shadow-inner">
                    <%= status_text %>
                  </span>
                </div>
              </div>
            </div>

            <% if @user == current_user %>
              <div class="border-t border-slate-100 pt-4 mt-2 flex justify-end items-center space-x-3 leading-none">
                <%= link_to "編集する", edit_shoe_path(shoe), class: "text-xs font-bold text-slate-400 hover:text-blue-500 transition-all duration-200 inline-flex items-center h-4" %>
                <span class="text-xs text-slate-300 self-center">|</span>
                <%= button_to "削除する", shoe_path(shoe), method: :delete, form: { class: "inline-flex items-center h-4", onsubmit: "return confirm('このシューズを一覧から削除してもよろしいですか？');" }, class: "text-xs font-bold text-slate-400 hover:text-red-500 transition-all duration-200 bg-transparent border-0 cursor-pointer p-0 m-0 leading-none inline-flex items-center" %>
              </div>
            <% end %>

          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-12 flex justify-center w-full">
      <%= link_to "走行記録一覧に戻る", user_jogs_path(@user), class: "w-full sm:w-52 bg-white/90 backdrop-blur-md hover:bg-white text-emerald-600 border border-emerald-200 font-black py-4 rounded-xl shadow-md active:translate-y-0.5 transition-all duration-200 text-center text-sm" %>
    </div>

  </div>
</div>