<h1 class="text-2xl font-bold mb-5">新規登録</h1>

<%# エラー表示 %>
<% if @user.errors.any? %>
  <div class="bg-red-100 text-red-800 p-4 mb-4 rounded">
    <ul>
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, class: "space-y-4 max-w-sm" do |f| %>
  <div>
    <%= f.label :name, "名前：" %>
    <%= f.text_field :name, class: "border p-2 w-full" %>
  </div>
  <div>
    <%= f.label :email, "メール：" %>
    <%= f.email_field :email, class: "border p-2 w-full" %>
  </div>
  <div>
    <%= f.label :password, "パスワード：" %>
    <%= f.password_field :password, class: "border p-2 w-full" %>
  </div>
  <div>
    <%= f.label :password_confirmation, "パスワード（確認）：" %>
    <%= f.password_field :password_confirmation, class: "border p-2 w-full" %>
  </div>
  <%= f.submit "登録する", class: "bg-blue-600 text-white px-4 py-2 rounded" %>
<% end %>