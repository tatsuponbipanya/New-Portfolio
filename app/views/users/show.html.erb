<div class="max-w-md mx-auto mt-10 p-6 bg-white rounded shadow">
  <h1 class="text-2xl font-bold mb-6 text-center">プロフィール詳細</h1>

  <div class="mb-4 border-b pb-2">
    <p class="text-gray-600 text-sm">ユーザー名</p>
    <p class="text-xl font-bold"><%= @user.name %></p>
  </div>

  <%# 自己紹介文の表示エリア %>
  <div class="mb-6">
    <p class="text-gray-600 text-sm">自己紹介文</p>
    <div class="mt-1 p-3 bg-gray-50 rounded border text-gray-800 whitespace-pre-wrap"><%= @user.introduction.present? ? @user.introduction : "自己紹介はまだ未設定です" %></div>
  </div>

  <%# 編集画面へ戻るためのリンクボタン %>
  <%= link_to "プロフィールを編集する", edit_user_path(@user), class: "block text-center bg-gray-500 text-white font-bold p-2 rounded hover:bg-gray-600" %>
</div>