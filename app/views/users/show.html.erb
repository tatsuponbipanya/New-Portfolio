<h1 class="text-2xl font-bold mb-6 text-center text-slate-800">プロフィール詳細</h1>

<div class="mb-4 border-b pb-2 font-bold">
  <p class="text-gray-600 text-sm">ユーザー名</p>
  <p class="text-xl font-bold"><%= @user.name %></p>
</div>

<div class="mb-6 font-bold">
  <p class="text-gray-600 text-sm">自己紹介文</p>
  <div class="mt-1 p-3 bg-gray-50 rounded border text-gray-800 whitespace-pre-wrap w-full">
    <%= @user.introduction.present? ? @user.introduction : "自己紹介はまだ未設定です" %>
  </div>
</div>

<% if @user == current_user %>
  <div class="mb-8">
    <%= link_to "プロフィールを編集する", edit_user_path(@user), class: "block text-center bg-slate-500 text-white font-bold p-2 rounded hover:bg-slate-600 max-w-md mx-auto" %>
  </div>
<% end %>

  <%# 左側：筋トレグループ %>
  <div class="flex-1 flex flex-col gap-2 p-2 bg-blue-50/50 border border-blue-100 rounded-xl">
    <span class="text-[10px] text-blue-500 uppercase tracking-widest pl-1">Muscle Training</span>
    <%= link_to "筋トレ記録を見る", user_workout_logs_path(@user), class: "w-full text-center bg-blue-600 text-white p-2.5 rounded-lg hover:bg-blue-700 shadow transition text-xs whitespace-nowrap" %>
    <%= link_to "推定MAX（1RM）の遷移", analytics_path(@user), class: "w-full text-center bg-blue-500 text-white p-2.5 rounded-lg hover:bg-blue-600 shadow transition text-xs whitespace-nowrap" %>
  </div>
  
  <%# 右側：ランニンググループ %>
  <div class="flex-1 flex flex-col gap-2 p-2 bg-orange-50/50 border border-orange-100 rounded-xl">
    <span class="text-[10px] text-orange-500 uppercase tracking-widest pl-1">Running</span>
    <div class="text-[10px] h-3"></div> 
    <%= link_to "ランニング記録を見る", user_jogs_path(@user), class: "w-full text-center bg-orange-500 text-white p-2.5 rounded-lg hover:bg-orange-600 shadow transition text-xs whitespace-nowrap mt-auto" %>
  </div>