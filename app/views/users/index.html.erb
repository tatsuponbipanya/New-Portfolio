<h1 class="text-3xl font-bold text-slate-800 mb-6 text-center">友達一覧！</h1>

<div class="users-list bg-[#ffffff] rounded shadow p-4 overflow-x-auto">
  <table class="w-full border-collapse text-left font-bold">
    <thead>
      <tr class="bg-slate-100 border-b-2 border-slate-200 text-slate-700">
        <th class="p-3">ユーザー名</th>
        <th class="p-3">自己紹介</th>
        <th class="p-3">詳細</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @users.each do |user| %>
        <tr class="hover:bg-slate-50 transition duration-150">
          <%# 👤 ユーザー名と会員ステータスバッジ %>
          <td class="p-3">
            <div class="flex items-center gap-2">
              <span class="text-slate-800 font-bold"><%= user.name %></span>
              
              <%# ここで会員ステータスを判定してバッジを出す %>
              <% if user.premium? %>
                <span class="text-[10px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded border border-amber-200">👑 プレミアム</span>
              <% else %>
                <span class="text-[10px] bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded border border-slate-200">一般</span>
              <% end %>
            </div>
          </td>
          
          <%# 自己紹介（長すぎると表が崩れるから truncate で1行に省略） %>
          <td class="p-3 text-slate-600 font-medium max-w-xs truncate">
            <%= user.introduction.present? ? user.introduction : "自己紹介はまだ未設定です" %>
          </td>
          
          <%# その人のマイページへ飛ぶリンクボタン %>
          <td class="p-3">
            <%= link_to "プロフィールを見る", user_path(user), class: "inline-block bg-blue-50 text-blue-600 border border-blue-200 hover:bg-blue-100 font-bold py-1 px-3 rounded text-xs transition" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>