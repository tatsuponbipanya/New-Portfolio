<div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-md border border-slate-200">
  <h2 class="text-xl font-black text-slate-800 mb-6 flex items-center gap-2">
    走った記録を残そう！
  </h2>

  <% if @shoes.blank? %>
    <div class="bg-amber-50 border border-amber-200 text-amber-800 p-4 rounded-md text-sm font-bold text-center my-6">
      <p class="mb-3">⚠️ まだシューズが登録されていません！</p>
      <p class="mb-4 text-xs font-medium text-amber-700">ランニングを記録するには、使用するシューズの登録が必要になります。</p>
      <%= link_to "シューズを登録する", new_shoe_path, class: "inline-block bg-amber-600 hover:bg-amber-700 text-white font-bold py-2 px-4 rounded-md shadow-sm transition duration-200" %>
    </div>
  <% else %>

    <%= form_with model: [@user, @jog], local: true, class: "space-y-5" do |f| %>

      <% if @jog.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-md text-sm font-bold">
          <ul class="list-disc pl-5 space-y-1">
            <% @jog.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      
      <%# 日付入力 %>
      <div>
        <%= f.label :date, "走った日", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.date_field :date, value: Time.zone.today, class: "w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium" %>
      </div>

      <%# シューズ選択（プルダウン） %>
      <div>
        <%= f.label :shoe_id, "使用したシューズ", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.collection_select :shoe_id, @shoes, :id, :name, { prompt: "シューズを選択して下さい" }, { class: "w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium cursor-pointer" } %>
      </div>

      <%# 走行距離入力 %>
      <div>
        <%= f.label :distance, "走行距離 (km)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <div class="relative">
          <%= f.text_field :distance, inputmode: "decimal", placeholder: "42.195", class: "w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium pr-12" %>
          <span class="absolute right-3 top-2.5 text-sm font-bold text-slate-400">km</span>
        </div>
      </div>

      <%# タイム入力（時間・分・秒） %>
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-1">タイム</label>
        <div class="flex items-center gap-2">
          <%= f.number_field :time_hour, value: 0, placeholder: "0", class: "w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium" %>
          <span class="text-sm font-bold text-slate-500">時間</span>
          <%= f.number_field :time_minute, placeholder: "0", class: "w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium" %>
          <span class="text-sm font-bold text-slate-500">分</span>
          <%= f.number_field :time_second, placeholder: "0", class: "w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium" %>
          <span class="text-sm font-bold text-slate-500">秒</span>
        </div>
      </div>

      <%# 心拍数入力 %>
      <div>
        <%= f.label :heart_rate, "平均心拍数 (bpm)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.number_field :heart_rate, placeholder: "130", class: "w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium" %>
      </div>

      <%# メモ入力 %>
      <div>
        <%= f.label :memo, "メモ・一言", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_area :memo, rows: 3, placeholder: "今日の調子はどうだった？", class: "w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium" %>
      </div>

      <%# 送信ボタン %>
      <div>
        <%= f.submit "記録を保存する！", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-4 rounded-md shadow-md cursor-pointer transition duration-200 text-center block" %>
      </div>

    <% end %>
  <% end %>
</div>