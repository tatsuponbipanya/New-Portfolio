<div class="max-w-4xl mx-auto bg-white p-4 sm:p-6 rounded-xl shadow-md border border-slate-200 mt-8">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-y-3 mb-6">
    <h2 class="text-xl sm:text-2xl font-black text-slate-800 flex items-center gap-2">
      <%= @user.name %>さんの年間走行実績
    </h2>
    <div class="flex-shrink-0">
      <%= link_to "月間記録へ戻る", user_jogs_path(@user), class: "inline-block bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold py-2 px-4 rounded shadow-sm transition text-sm text-center" %>
    </div>
  </div>

  <%# === 年切り替えプルダウン === %>
  <% if @available_years.any? %>
    <div class="mb-6 flex justify-end">
      <%= form_with url: annual_user_jogs_path(@user), method: :get, local: true, class: "inline-block" do |f| %>
        <div class="relative">
          <select name="year" onchange="this.form.submit()" class="block appearance-none w-full bg-white border border-slate-300 text-slate-700 py-2 px-4 pr-8 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-bold text-sm cursor-pointer">
            <% @available_years.each do |year| %>
              <option value="<%= year %>" <%= 'selected' if @selected_year == year %>>
                <%= year %>年
              </option>
            <% end %>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-500">
            <svg class="fill-current h-4 w-4" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# === 年間トータル実績 === %>
  <div class="bg-blue-50 border-l-4 border-blue-600 p-4 mb-8 rounded-r-lg shadow-sm">
    <h3 class="text-lg font-black text-slate-800"><%= @selected_year %>年の年間実績</h3>
    <p class="text-sm font-bold text-slate-600 mt-2 flex items-center gap-4">
      <span>🏃‍♂️ 年間走行距離: <span class="text-blue-600 text-xl"><%= @total_distance %> km</span></span>
    </p>
    <p class="text-sm font-bold text-slate-600 mt-1 flex items-center gap-4">
      <span>⏱️ 年間走行時間: <span class="text-blue-600 text-xl"><%= "#{@total_h}時間 " if @total_h > 0 %><%= "#{@total_m}分#{@total_s}秒" %></span></span>
    </p>
  </div>

  <%# === 月別グラフ（距離） === %>
  <h2 class="text-lg sm:text-xl font-bold mt-8 mb-4">月間走行距離の推移 (km)</h2>
  
  <%# グラフライブラリの読み込み %>
  <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
  <script type="text/javascript" src="https://unpkg.com/chartkick@5.0.0/dist/chartkick.js"></script>

  <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm mb-8">
    <div id="distance-chart" style="height: 300px; width: 100%;"></div>
  </div>

  <%# === 月別グラフ（時間） === %>
  <h2 class="text-lg sm:text-xl font-bold mt-8 mb-4">月間走行時間の推移 (分)</h2>
  <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm mb-8">
    <div id="time-chart" style="height: 300px; width: 100%;"></div>
  </div>

  <script type="text/javascript">
    window.onload = function() {
      // コントローラーから渡されたデータ
      var distanceData = <%= @distance_chart_data.to_json.html_safe %>;
      var timeData = <%= @time_chart_data.to_json.html_safe %>;
      
      // 距離の折れ線グラフ（青色）
      new Chartkick.LineChart("distance-chart", distanceData, {
        colors: ["#3b82f6"],
        library: {
          vAxis: { title: '距離 (km)' },
          hAxis: { title: '月' }
        },
        empty: "まだこの年の記録がありません"
      });

      // 時間の折れ線グラフ（緑色）
      new Chartkick.LineChart("time-chart", timeData, {
        colors: ["#10b981"],
        library: {
          vAxis: { title: '時間 (分)' },
          hAxis: { title: '月' }
        },
        empty: "まだこの年の記録がありません"
      });
    }
  </script>

  <div class="mt-6 text-center border-t pt-4">
    <%= link_to "プロフィールへ戻る", user_path(@user), class: "text-sm text-slate-500 hover:text-slate-700 font-bold" %>
  </div>
</div>