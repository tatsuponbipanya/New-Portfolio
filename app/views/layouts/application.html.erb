<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Portfolio V2" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Portfolio V2">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# すべてのCSSとJSはここでまとめて読み込む %>
    <%= stylesheet_link_tag :app %>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <%= javascript_include_tag "push_notification", defer: true, type: "module" %>

    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# ========================================== %>
    <%# 手動PWA（Progressive Web App）用の設定コード。ホーム画面に追加出来るようになり、普通のアプリと変わらない使い心地になる %>
    <%# ========================================== %>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#3b82f6">

    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/service-worker.js')
          .then(registration => console.log('PWA登録成功！'))
          .catch(error => console.log('PWA登録失敗:', error));
      }
    </script>

    <%# PWAのWeb Push用の公開鍵をJavaScriptに渡すタグ %>
    <meta name="vapid-public-key" content="<%= Rails.application.credentials.dig(:vapid, :public_key) %>">

    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <body class="bg-slate-50 text-slate-800">

<header class="flex justify-between items-center p-5 border-b bg-white shadow-sm">
  <%# --- 左側：ロゴ --- %>
  <div class="flex items-center">
    <%= link_to root_path, class: "text-2xl font-extrabold tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-500 font-mono" do %>
      MUSCLE_LOG
    <% end %>
  </div>
  
  <%# --- 右側：全部メニューに集約！ --- %>
  <div class="flex items-center gap-4">
    <% if current_user %>
      
      <%# ここでヘッダーの名前部分をプレミアムと一般で分ける %>
      <% if current_user.premium? %>
        <%# 👑 プレミアム会員用 %>
        <div class="flex items-center bg-amber-50 border border-amber-200 rounded-full px-3 py-1.5 shadow-sm">
          <span class="text-xs font-extrabold text-amber-700 tracking-wide flex items-center gap-1">
            👑 <%= current_user.name %>
          </span>
          <span class="text-[10px] font-bold text-amber-600 ml-1">
            online
          </span>
        </div>
      <% else %>
        <%# 👤 一般会員用 %>
        <div class="flex items-center bg-slate-50 border border-slate-200 rounded-full px-3 py-1.5 shadow-sm">
          <span class="text-xs font-extrabold text-slate-700 tracking-wide flex items-center gap-1">
            <%= current_user.name %> <span class="text-[10px] text-slate-400 font-medium">(一般)</span>
          </span>
          <span class="text-[10px] font-bold text-slate-500 ml-1">
            online
          </span>
        </div>
      <% end %>

      <div x-data="{ open: false }" class="relative" @click.away="open = false">
        <button @click="open = !open" class="bg-slate-100 hover:bg-slate-200 font-bold py-2 px-4 rounded-md text-sm border border-slate-200 flex items-center gap-1 cursor-pointer">
          メニュー ▾
        </button>

        <div x-show="open" x-transition class="absolute right-0 mt-2 w-56 bg-white border border-slate-200 rounded-xl shadow-xl py-2 z-50 font-bold text-sm" style="display: none;">
          <p class="px-4 py-1 text-[10px] text-slate-400 uppercase tracking-widest">Muscle Training</p>
          <%= link_to "筋トレを始める！", user_workout_logs_path(current_user), class: "block px-4 py-2 text-slate-700 hover:bg-blue-50" %>
          <%= link_to "筋トレ記録一覧", user_workout_logs_page_path(current_user), class: "block px-4 py-2 text-slate-700 hover:bg-blue-50" %>
          <%= link_to "MAX重量（1RM）の確認", analytics_path(current_user), class: "block px-4 py-2 text-slate-700 hover:bg-blue-50" %>
          <%= link_to "テンプレート作成＋", new_workout_template_path, class: "block px-4 py-2 text-slate-700 hover:bg-emerald-50" %>
          <%= link_to "テンプレート管理", manage_workout_templates_path, class: "block px-4 py-2 text-slate-700 hover:bg-blue-50" %>
          
          <hr class="border-slate-100 my-2">
          
          <p class="px-4 py-1 text-[10px] text-slate-400 uppercase tracking-widest">Running</p>
          <%= link_to "ランニングを記録！", new_user_jog_path(current_user), class: "block px-4 py-2 text-emerald-700 hover:bg-emerald-50" %>
          <%= link_to "月間走行記録", user_jogs_path(current_user), class: "block px-4 py-2 text-emerald-700 hover:bg-emerald-50" %>
          <%= link_to "年間走行記録", annual_user_jogs_path(current_user), class: "block px-4 py-2 text-emerald-700 hover:bg-emerald-50" %>
          <%= link_to "マイシューズを登録＋", new_shoe_path , class: "block px-4 py-2 text-emerald-700 hover:bg-emerald-50" %>
          <%= link_to "マイシューズ一覧", user_shoes_path(current_user), class: "block px-4 py-2 text-emerald-700 hover:bg-emerald-50" %>
          
          <hr class="border-slate-100 my-2">
          
          <p class="px-4 py-1 text-[10px] text-slate-400 uppercase tracking-widest">Account</p>
          <%= link_to "マイページ（プロフィール）", user_path(current_user), class: "block px-4 py-2 text-slate-700 hover:bg-blue-50" %>
          <%= link_to "友達の記録を見る！", users_path, class: "block px-4 py-2 text-slate-700 hover:bg-blue-50" %>

          <%# 一般会員のときだけ、応援ボタンを表示する %>
          <% unless current_user.premium? %>
            <%= button_to "500円で開発者を応援する！", checkouts_path, method: :post, data: { turbo: false }, form_class: "block", class: "w-full text-left px-4 py-2 text-amber-600 hover:bg-amber-50 cursor-pointer font-bold" %>
          <% end %>

          <hr class="border-slate-100 my-1">

          <%= button_to "ログアウト", logout_path, method: :delete, class: "w-full text-left px-4 py-2 text-red-600 hover:bg-red-50 cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
</header>

    <main class="container mx-auto mt-10 px-5 max-w-2xl flex flex-col">
      <% flash.each do |name, msg| %>
        <% 
          # 失敗系（alert, danger, error）なら赤、それ以外は緑
          if name == 'alert' || name == 'danger' || name == 'error'
            alert_classes = "bg-red-100 text-red-800 border border-red-200"
          else
            alert_classes = "bg-green-100 text-green-800 border border-green-200"
          end
        %>
        <div class="mb-4 p-4 rounded-md font-bold text-center <%= alert_classes %>">
          <%= msg %>
        </div>
      <% end %>

      <%# 各ページの中身 %>
      <%= yield %>
    </main>
  </body>
</html>