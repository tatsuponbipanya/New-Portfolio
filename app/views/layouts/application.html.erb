<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Portfolio V2" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Portfolio V2">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# すべてのCSSとJSはここでまとめて読み込む %>
    <%= stylesheet_link_tag :app %>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
  </head>

  <body>
    <header class="flex justify-between items-center p-5 border-b">
      <%# ログインしているなら root_path(記録一覧)、していないなら root_path(landing) に飛ぶ %>
      <%= link_to root_path, class: "text-2xl font-extrabold tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-500 font-mono" do %>
        MUSCLE_LOG
      <% end %>
      <div class="flex items-center gap-3">
        <% if current_user %>
          <p><%= current_user.name %> さんこんにちは！</p>
          <%= button_to "ログアウト", logout_path, method: :delete, class: "bg-red-500 text-white px-2 py-1 rounded cursor-pointer" %>
        <% else %>
          <%= link_to "ログイン", login_path, class: "bg-blue-500 text-white px-2 py-1 rounded cursor-pointer" %>
        <% end %>
      </div>
    </header>

    <main class="container mx-auto mt-10 px-5 max-w-2xl flex flex-col">
      <%# フラッシュメッセージの表示を追加 %>
      <% flash.each do |name, msg| %>
        <div class="mb-4 p-4 rounded-md font-bold text-center <%= name == 'alert' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>">
          <%= msg %>
        </div>
      <% end %>

      <%# ここが各ページのメインの中身が入るところ。 %>
      <%= yield %>
    </main>
  </body>
</html>
