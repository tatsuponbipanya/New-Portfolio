<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Portfolio V2" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Portfolio V2">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# すべてのCSSとJSはここでまとめて読み込む %>
    <%= stylesheet_link_tag :app %>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
  </head>

  <body class="bg-slate-50 text-slate-800">
    <header class="flex justify-between items-center p-5 border-b bg-white shadow-sm">
      <%# ログインしているなら root_path(記録一覧)、していないなら root_path(landing) に飛ぶ %>
      <%= link_to root_path, class: "text-2xl font-extrabold tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-500 font-mono" do %>
        MUSCLE_LOG
      <% end %>
      
      <%# 横並びのアイテム同士の隙間を gap-4 に広げて、見やすくする %>
      <div class="flex items-center gap-4">
        <% if current_user %>
          <%# ログイン中のユーザー名を常時表示するネームタグ %>
          <p class="text-sm font-bold text-slate-600 bg-slate-100 px-3 py-1.5 rounded-full border border-slate-200">
            👤 <span class="text-slate-800 font-extrabold"><%= current_user.name %></span> さんいらっしゃい！
          </p>

          <%# Alpine.js を使ったプルダウンメニュー %>
          <div x-data="{ open: false }" class="relative" @click.away="open = false">
            <%# ボタン部分 %>
            <button @click="open = !open" class="bg-slate-100 hover:bg-slate-200 font-bold py-2 px-4 rounded-md text-sm border border-slate-200 flex items-center gap-1 cursor-pointer select-none">
              メニュー ▾
            </button>

            <%# プルダウンの中身 %>
            <div x-show="open" 
                 x-transition
                 class="absolute right-0 mt-2 w-48 bg-white border border-slate-200 rounded-md shadow-lg py-1 z-50 font-bold text-sm" 
                 style="display: none;">
              <%= link_to "筋トレを始める！", root_path, class: "block px-4 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-600 border-b border-slate-100" %>
              <%= link_to "マイページ", user_path(current_user), class: "block px-4 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-600" %>
              <%= link_to "推定MAX（1RM）の遷移", analytics_path(current_user), class: "block px-4 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-600" %>
              <%= link_to "筋トレ仲間一覧", users_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 font-bold" %>
              <hr class="border-slate-100 my-1">
              <%= button_to "ログアウト", logout_path, method: :delete, class: "w-full text-left px-4 py-2 text-red-600 hover:bg-red-50 cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>
    </header>

    <main class="container mx-auto mt-10 px-5 max-w-2xl flex flex-col">
      <%# フラッシュメッセージの表示を追加 %>
      <% flash.each do |name, msg| %>
        <div class="mb-4 p-4 rounded-md font-bold text-center <%= name == 'alert' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>">
          <%= msg %>
        </div>
      <% end %>

      <%# ここが各ページのメインの中身が入るところ。 %>
      <%= yield %>
    </main>
  </body>
</html>