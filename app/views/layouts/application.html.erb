<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Portfolio V2" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Portfolio V2">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# すべてのCSSとJSはここでまとめて読み込む %>
    <%= stylesheet_link_tag :app %>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
  </head>

  <body>
    <header class="flex justify-between items-center p-5 border-b">
      <h1 class="text-xl font-bold">筋トレ記録アプリ</h1>
      
      <div class="flex items-center gap-3">
        <% if current_user %>
          <p><%= current_user.name %> さんこんにちは！</p>
          <%= button_to "ログアウト", logout_path, method: :delete, class: "bg-red-500 text-white px-2 py-1 rounded cursor-pointer" %>
        <% else %>
          <%= link_to "ログイン", login_path, class: "bg-blue-500 text-white px-2 py-1 rounded cursor-pointer" %>
        <% end %>
      </div>
    </header>

    <main class="container mx-auto mt-10 px-5 max-w-2xl flex flex-col">
      <%# ここが各ページのメインの中身が入るところ。 %>
      <%= yield %>
    </main>
  </body>
</html>
