<h1 class="text-3xl font-bold text-slate-800 mb-2">筋トレ記録（Rails 8 新ポートフォリオ）</h1>
<p class="text-sm text-gray-500 mb-6">開発中です</p>

<% flash.each do |name, msg| %>
  <div class="flash-message <%= name %> bg-green-100 border border-green-300 text-green-800 px-4 py-3 my-4 rounded-md font-bold text-center">
    <%= msg %>
  </div>
<% end %>

<% #入力エラーがあればエラーメッセージ表示 %>
<% if @workout_log && @workout_log.errors.any? %>
  <div class="error-messages bg-red-50 border border-red-200 text-red-800 p-4 my-4 rounded-md">
    <p class="font-bold mb-2">⚠️ 入力内容を確認してください：</p>
    <ul class="list-disc pl-5 space-y-1 font-bold">
      <% @workout_log.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% #データ入力用フォーム %>
<%= form_with model: @workout_log, class: "space-y-4 max-w-md" do |f| %>
  <div class="flex flex-col">
    <%= f.label :workout_date, "トレーニング日：", class: "font-bold text-slate-700 mb-1" %>
    <%= f.date_field :workout_date, value: Time.zone.today, class: "border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="flex flex-col">
    <%= f.label :menu_type, "種目名：", class: "font-bold text-slate-700 mb-1" %>
    <%= f.select :menu_type, [["ベンチプレス", "ベンチプレス"], ["チンニング", "チンニング"],  ["スクワット", "スクワット"], ["ディップス", "ディップス"], ["ハンマーカール", "ハンマーカール"], ["サイドレイズ", "サイドレイズ"], ["デッドリフト", "デッドリフト"]],
     { prompt: "種目を選択" }, { class: "border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" } %>
  </div>

  <div class="flex flex-col">
    <%= f.label :weight, "重量 (kg) ※自重は0kgで登録してください", class: "font-bold text-slate-700 mb-1" %>
    <%= f.number_field :weight, step: 0.1, placeholder: "例：83.0", class: "border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="flex flex-col">
    <%= f.label :reps, "回数 (Reps)：", class: "font-bold text-slate-700 mb-1" %>
    <%= f.number_field :reps, placeholder: "例：1", class: "border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div>
    <%= f.submit "筋肉を記録する！", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-4 rounded shadow-md cursor-pointer transition duration-200" %>
  </div>
<% end %>

<% #区切り線 %>
<hr class="my-10 border-0 border-t-2 border-dashed border-slate-300">

<h2 class="text-xl font-bold text-slate-800 mb-4">🏋️‍♂️ 過去の筋トレ記録一覧</h2>
<div class="workout-logs-list overflow-x-auto">
  <% if @workout_logs && @workout_logs.any? %>
    <table class="w-full border-collapse text-left font-bold">
      <thead>
        <tr class="bg-slate-100 border-b-2 border-slate-200 text-slate-700">
          <th class="p-3">日付</th>
          <th class="p-3">種目名</th>
          <th class="p-3">重量 (kg)</th>
          <th class="p-3">回数 (Reps)</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @workout_logs.each do |log| %>
          <tr class="hover:bg-slate-50 transition duration-150">
            <td class="p-3 text-slate-600"><%= log.workout_date.strftime("%Y/%m/%d") %></td>
            <td class="p-3 text-blue-600"><%= log.menu_type %></td>
            <td class="p-3 text-slate-800"><%= log.weight %> kg</td>
            <td class="p-3 text-slate-800"><%= log.reps %> 回</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-slate-500 italic">まだ記録がありません。</p>
  <% end %>
</div>