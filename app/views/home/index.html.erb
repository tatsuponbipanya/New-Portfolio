<h1 class="text-3xl font-bold text-slate-800 mb-2">筋トレを記録しよう！</h1>
<p class="text-sm text-gray-500 mb-6">※開発中です</p>

<% #入力エラーがあればエラーメッセージ表示 %>
<% if @workout_log && @workout_log.errors.any? %>
  <div class="error-messages bg-red-50 border border-red-200 text-red-800 p-4 my-4 rounded-md">
    <p class="font-bold mb-2">⚠️ 入力内容を確認してください：</p>
    <ul class="list-disc pl-5 space-y-1 font-bold">
      <% @workout_log.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% #データ入力用フォーム %>
<%= form_with model: @workout_log, class: "space-y-4 max-w-md pb-16" do |f| %>
  <div class="flex flex-col">
    <%= f.label :workout_date, "トレーニング日時：", class: "font-bold text-slate-700 mb-1" %>
    <%= f.datetime_field :workout_date, value: Time.current.change(sec: 0), step: 60, class: "border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="flex flex-col">
    <%= f.label :menu_type, "種目名：", class: "font-bold text-slate-700 mb-1" %>
    <%= f.select :menu_type, [["ベンチプレス", "ベンチプレス"], ["チンニング", "チンニング"],  ["スクワット", "スクワット"], ["ディップス", "ディップス"], ["ハンマーカール", "ハンマーカール"], ["サイドレイズ", "サイドレイズ"], ["デッドリフト", "デッドリフト"]],
       { prompt: "種目を選択" }, { class: "border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" } %>
  </div>

  <div class="flex flex-col">
    <%= f.label :weight, "重量 (kg) ※自重は0kgで登録してください", class: "font-bold text-slate-700 mb-1" %>
    <%= f.number_field :weight, step: 0.1, placeholder: "例：83.0", class: "border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="flex flex-col">
    <%= f.label :reps, "回数 (Reps)：", class: "font-bold text-slate-700 mb-1" %>
    <%= f.number_field :reps, placeholder: "例：1", class: "border border-slate-300 rounded px-3 py-2 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div>
    <%= f.submit "筋肉を記録する！", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-4 rounded shadow-md cursor-pointer transition duration-200" %>
  </div>
<% end %>